# Шаблон переменных окружения manage. Копируй в .env и заполняй.
# .env не коммитится (см. .gitignore); этот файл — единственный источник имён ключей.

# Брокер (адрес внутри сети compose — общий для сервисов программы)
BROKER_ADDR=broker:9092

# Пин контракта, на котором работает сервис (хаб поддерживает CONVENTIONS@v1)
CONVENTIONS_PIN=v1

# Control API (control-plane edge manage→engine)
MANAGE_HTTP_ADDR=:8081
MANAGE_LOG_LEVEL=info

# Proxmox API (placeholder — НЕТ реальных секретов в репо; заполняй в .env)
PROXMOX_API_URL=
PROXMOX_TOKEN=